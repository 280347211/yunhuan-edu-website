generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Article {
  id        Int      @id @default(autoincrement())
  title     String
  content   String
  summary   String?
  cover     String?
  category  String   @default("news")
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SiteConfig {
  id    Int    @id @default(autoincrement())
  key   String @unique
  value String
}

model Image {
  id        Int      @id @default(autoincrement())
  filename  String
  original  String
  path      String
  alt       String?
  category  String?
  createdAt DateTime @default(now())
}
