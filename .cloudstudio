[[app]]
name = "frontend"
cmd = "cd frontend && pnpm install && node -e \"const{execSync}=require('child_process');execSync('npx next build',{stdio:'inherit',maxBuffer:50*1024*1024})\" && npx next start --port 5173"
autoRun = true
port = 5173

[[app]]
name = "backend"
cmd = "cd backend && pnpm install && pnpm exec tsx src/index.ts"
autoRun = true
port = 3000
