");\n    } catch {\n      toast.error(\"保存失败\");\n    }\n  };\n\n  if (loading) return <div className=\"p-8 text-center text-[#475569]\">加载中...</div>;\n\n  return (\n    <div className=\"p-8\">\n      <div className=\"flex items-center justify-between mb-6\">\n        <h1 className=\"text-2xl font-bold text-[#0f172a]\">网站设置</h1>\n        <Button onClick={handleSave} className=\"text-white border-0\" style={{ background: \"linear-gradient(135deg, #1a56db 0%, #3b82f6 100%)\" }}>\n          保存设置\n        </Button>\n      </div>\n\n      <div className=\"space-y-6 max-w-3xl\">\n        {configGroups.map((group) => (\n          <Card key={group.title} className=\"border-[#e2e8f0]\">\n            <CardContent className=\"p-6\">\n              <h3 className=\"font-bold text-[#0f172a] mb-4\">{group.title}</h3>\n              <div className=\"space-y-4\">\n                {group.fields.map((field) => (\n                  <div key={field.key}>\n                    <label className=\"block text-sm font-medium text-[#475569] mb-1.5\">\n                      {field.label}\n                    </label>\n                    {field.multiline ? (\n                      <textarea\n                        value={form[field.key] || \"\"}\n                        onChange={(e) => setForm((prev) => ({ ...prev, [field.key]: e.target.value }))}\n                        rows={4}\n                        className=\"w-full px-3 py-2 rounded-md border border-[#e2e8f0] text-sm resize-none\"\n                      />\n                    ) : (\n                      <Input\n                        value={form[field.key] || \"\"}\n                        onChange={(e) => setForm((prev) => ({ ...prev, [field.key]: e.target.value }))}\n                      />\n                    )}\n                  </div>\n                ))}\n              </div>\n            </CardContent>\n          </Card>\n        ))}\n      </div>\n    </div>\n  );\n}\n","file_path":"/workspace/frontend/src/pages/admin/Settings.tsx"},"tool_response":"Successfully created and wrote to new file: /workspace/frontend/src/pages/admin/Settings.tsx","call_id":"call_b1b3514a2afb41acbc00e97d","tool_use_id":"call_b1b3514a2afb41acbc00e97d","permission_mode":"dontAsk","client":"CLI","version":"2.94.0","generation_id":"ed95145cf4904ca78b4d6b55e258a543","model":"glm-5.1"}
