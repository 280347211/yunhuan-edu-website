[2026-05-11 01:46:56] [DEBUG] [PPT PostToolUse Hook] stdin 数据: {"session_id":"2053007833335468032","transcript_path":"/root/.codebuddy/projects/workspace/2053007833335468032.jsonl","cwd":"/workspace","hook_event_name":"PostToolUse","tool_name":"Write","tool_input":{"content":"import { useArticles } from \"@/hooks/use-articles\";\nimport { useProducts } from \"@/hooks/use-products\";\nimport { FileText, Package, Eye, Clock } from \"lucide-react\";\nimport { Card, CardContent } from \"@/components/ui/card\";\n\nexport default function AdminDashboard() {\n  const { items: articles, total: articleTotal } = useArticles({ status: 1 });\n  const { products } = useProducts();\n\n  const publishedCount = articles.filter((a) => a.status === 1).length;\n  const draftCount = articles.filter((a) => a.status === 0).length;\n\n  const stats = [\n    { icon: FileText, label: \"文章总数\", value: articleTotal, color: \"#1a56db\" },\n    { icon: Eye, label: \"已发布\", value: publishedCount, color: \"#22c55e\" },\n    { icon: Clock, label: \"草稿\", value: draftCount, color: \"#f59e0b\" },\n    { icon: Package, label: \"产品数\", value: products.length, color: \"#6366f1\" },\n  ];\n\n  return (\n    <div className=\"p-8\">\n      <h1 className=\"text-2xl font-bold text-[#0f172a] mb-6\">仪表盘</h1>\n\n      <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 mb-8\">\n        {stats.map((s) => (\n          <Card key={s.label} className=\"border-[#e2e8f0]\">\n            <CardContent className=\"p-5 flex items-center gap-4\">\n              <div\n                className=\"w-12 h-12 rounded-xl flex items-center justify-center\"\n                style={{ background: `${s.color}10`, color: s.color }}\n              >\n                <s.icon className=\"w-6 h-6\" />\n              </div>\n              <div>\n                <div className=\"text-2xl font-bold text-[#0f172a]\">{s.value}</div>\n                <div className=\"text-sm text-[#475569]\">{s.label}</div>\n              </div>\n            </CardContent>\n          </Card>\n        ))}\n      </div>\n\n      <h2 className=\"text-lg font-bold text-[#0f172a] mb-4\">最近文章</h2>\n      <div className=\"space-y-3\">\n        {articles.slice(0, 5).map((a) => (\n          <div\n            key={a.id}\n            className=\"flex items-center justify-between p-4 bg-white rounded-lg border border-[#e2e8f0]\"\n          >\n            <div className=\"flex items-center gap-3\">\n              <span\n                className={`px-2 py-0.5 rounded text-xs font-medium ${\n                  a.status === 1 ? \"bg-green-50 text-green-600\" : \"bg-amber-50 text-amber-600\"\n                }`}\n              >\n                {a.status === 1 ? \"已发布\" : \"草稿\"}\n              </span>\n              <span className=\"font-medium text-sm text-[#0f172a]\">{a.title}</span>\n            </div>\n            <span className=\"text-xs text-[#94a3b8]\">\n              {a.createtime ? new Date(a.createtime * 1000).toLocaleDateString(\"zh-CN\") : \"-\"}\n            </span>\n          </div>\n        ))}\n      </div>\n    </div>\n  );\n}\n","file_path":"/workspace/frontend/src/pages/admin/Dashboard.tsx"},"tool_response":"Successfully overwrote file: /workspace/frontend/src/pages/admin/Dashboard.tsx","call_id":"call_6601db3f373940fe915af90e","tool_use_id":"call_6601db3f373940fe915af90e","permission_mode":"dontAsk","client":"CLI","version":"2.94.0","generation_id":"aa76fecfcf354b0eb2a2d33a594550e2","model":"glm-5.1"}
