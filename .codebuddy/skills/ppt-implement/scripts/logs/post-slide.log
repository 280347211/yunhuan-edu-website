Clock,\n      title: \"工作时间\",\n      content: \"周一至周五\",\n      sub: \"9:00 - 18:00\",\n      href: null,\n    },\n  ];\n\n  const handleSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!formState.name || !formState.phone || !formState.message) {\n      toast.error(\"请填写必填信息\");\n      return;\n    }\n    setSubmitted(true);\n    toast.success(\"提交成功，我们将尽快与您联系！\");\n  };\n\n  const handleChange = (field: string) => (e: React.ChangeEvent<HTMLInputElement | HTMLTextAreaElement>) => {\n    setFormState((prev) => ({ ...prev, [field]: e.target.value }));\n  };\n\n  return (\n    <main>\n      {/* ── Page Hero ── */}\n      <section className=\"relative pt-32 pb-20 overflow-hidden\">\n        <div className=\"absolute inset-0 hero-gradient\" />\n        <div\n          className=\"absolute inset-0 pointer-events-none\"\n          style={{ background: \"radial-gradient(circle at 60% 40%, rgba(59,130,246,0.2) 0%, transparent 50%)\" }}\n        />\n        <div className=\"container mx-auto px-6 lg:px-8 relative z-10\">\n          <FadeIn>\n            <p className=\"text-[#93c5fd] text-sm font-medium tracking-widest uppercase mb-3\">\n              Contact Us\n            </p>\n            <h1 className=\"text-white text-4xl lg:text-5xl font-bold mb-4\">联系我们</h1>\n            <p className=\"text-white/70 text-lg max-w-2xl\">\n              期待与您携手，共同推动教育信息化发展\n            </p>\n          </FadeIn>\n        </div>\n      </section>\n\n      {/* ── Contact Info Cards ── */}\n      <section className=\"py-20 lg:py-28 bg-white\">\n        <div className=\"container mx-auto px-6 lg:px-8\">\n          <Stagger className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-20\">\n            {contactInfo.map((info) => (\n              <motion.div key={info.title} variants={fadeUp}>\n                <Card className=\"h-full border-[#e2e8f0] hover:border-[#3b82f6]/30 transition-all duration-300\">\n                  <CardContent className=\"p-6 text-center\">\n                    <div\n                      className=\"w-14 h-14 rounded-xl flex items-center justify-center mx-auto mb-4\"\n                      style={{ background: \"#eff6ff\", color: \"#1a56db\" }}\n                    >\n                      <info.icon className=\"w-7 h-7\" />\n                    </div>\n                    <h3 className=\"font-bold text-[#0f172a] mb-2\">{info.title}</h3>\n                    {info.href ? (\n                      <a\n                        href={info.href}\n                        className=\"text-[#1a56db] font-medium text-sm hover:underline\"\n                      >\n                        {info.content}\n                      </a>\n                    ) : (\n                      <p className=\"text-[#0f172a] font-medium text-sm\">{info.content}</p>\n                    )}\n                    <p className=\"text-[#94a3b8] text-xs mt-1\">{info.sub}</p>\n                  </CardContent>\n                </Card>\n              </motion.div>\n            ))}\n          </Stagger>\n\n          {/* ── Form + Map ── */}\n          <div className=\"grid grid-cols-1 lg:grid-cols-2 gap-10\">\n            {/* Contact Form */}\n            <FadeIn>\n              <div className=\"bg-white rounded-xl border border-[#e2e8f0] p-8\">\n                <h3 className=\"font-bold text-xl text-[#0f172a] mb-2\">在线留言</h3>\n                <p className=\"text-sm text-[#475569] mb-6\">填写以下信息，我们将尽快与您联系</p>\n\n                {submitted ? (\n                  <div className=\"flex flex-col items-center justify-center py-12 text-center\">\n                    <div className=\"w-16 h-16 rounded-full flex items-center justify-center mb-4\" style={{ background: \"#eff6ff\" }}>\n                      <CheckCircle className=\"w-8 h-8 text-[#1a56db]\" />\n                    </div>\n                    <h4 className=\"font-bold text-lg text-[#0f172a] mb-2\">提交成功</h4>\n                    <p className=\"text-sm text-[#475569]\">感谢您的留言，我们的顾问将在24小时内与您联系</p>\n                    <Button\n                      variant=\"outline\"\n                      className=\"mt-6 border-[#1a56db] text-[#1a56db]\"\n                      onClick={() => {\n                        setSubmitted(false);\n                        setFormState({ name: \"\", phone: \"\", email: \"\", company: \"\", message: \"\" });\n                      }}\n                    >\n                      继续留言\n                    </Button>\n                  </div>\n                ) : (\n                  <form onSubmit={handleSubmit} className=\"space-y-4\">\n                    <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n                      <div>\n                        <label className=\"block text-sm font-medium text-[#0f172a] mb-1.5\">\n                          姓名 <span className=\"text-red-500\">*</span>\n                        </label>\n                        <Input\n                          value={formState.name}\n                          onChange={handleChange(\"name\")}\n                          placeholder=\"请输入姓名\"\n                          className=\"border-[#e2e8f0] focus:border-[#1a56db]\"\n                        />\n                      </div>\n                      <div>\n                        <label className=\"block text-sm font-medium text-[#0f172a] mb-1.5\">\n                          电话 <span className=\"text-red-500\">*</span>\n                        </label>\n                        <Input\n                          value={formState.phone}\n                          onChange={handleChange(\"phone\")}\n                          placeholder=\"请输入联系电话\"\n                          className=\"border-[#e2e8f0] focus:border-[#1a56db]\"\n                        />\n                      </div>\n                    </div>\n                    <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n                      <div>\n                        <label className=\"block text-sm font-medium text-[#0f172a] mb-1.5\">邮箱</label>\n                        <Input\n                          type=\"email\"\n                          value={formState.email}\n                          onChange={handleChange(\"email\")}\n                          placeholder=\"请输入邮箱地址\"\n                          className=\"border-[#e2e8f0] focus:border-[#1a56db]\"\n                        />\n                      </div>\n                      <div>\n                        <label className=\"block text-sm font-medium text-[#0f172a] mb-1.5\">学校/单位</label>\n                        <Input\n                          value={formState.company}\n                          onChange={handleChange(\"company\")}\n                          placeholder=\"请输入学校或单位名称\"\n                          className=\"border-[#e2e8f0] focus:border-[#1a56db]\"\n                        />\n                      </div>\n                    </div>\n                    <div>\n                      <label className=\"block text-sm font-medium text-[#0f172a] mb-1.5\">\n                        留言内容 <span className=\"text-red-500\">*</span>\n                      </label>\n                      <Textarea\n                        value={formState.message}\n                        onChange={handleChange(\"message\")}\n                        placeholder=\"请描述您的需求或问题\"\n                        rows={5}\n                        className=\"border-[#e2e8f0] focus:border-[#1a56db] resize-none\"\n                      />\n                    </div>\n                    <Button\n                      type=\"submit\"\n                      className=\"w-full text-white font-medium border-0\"\n                      style={{ background: \"linear-gradient(135deg, #1a56db 0%, #3b82f6 100%)\" }}\n                    >\n                      <Send className=\"w-4 h-4 mr-2\" />\n                      提交留言\n                    </Button>\n                  </form>\n                )}\n              </div>\n            </FadeIn>\n\n            {/* Map / Location */}\n            <FadeIn delay={0.2}>\n              <div className=\"rounded-xl overflow-hidden border border-[#e2e8f0] h-full min-h-[400px] flex flex-col\">\n                <div\n                  className=\"flex-1 flex items-center justify-center\"\n                  style={{ background: \"linear-gradient(135deg, #1e3a8a 0%, #1a56db 100%)\" }}\n                >\n                  <div className=\"text-center text-white p-8\">\n                    <MapPin className=\"w-12 h-12 mx-auto mb-4 opacity-80\" />\n                    <h4 className=\"font-bold text-lg mb-2\">{config.address || \"广东省深圳市南山区科技园南区\"}</h4>\n                    <p className=\"text-white/70 text-sm\">云幻教育科技股份有限公司</p>\n                    <p className=\"text-white/50 text-xs mt-4\">电话：{config.site_tel || \"4008-988-168\"}</p>\n                    <p className=\"text-white/50 text-xs mt-1\">邮箱：{config.site_email || \"market@yunhuanedu.com\"}</p>\n                  </div>\n                </div>\n              </div>\n            </FadeIn>\n          </div>\n        </div>\n      </section>\n    </main>\n  );\n}\n","file_path":"/workspace/frontend/src/pages/Contact.tsx"},"tool_response":"Successfully overwrote file: /workspace/frontend/src/pages/Contact.tsx","call_id":"call_7c551eeac1d14bc3b49fd0ef","tool_use_id":"call_7c551eeac1d14bc3b49fd0ef","permission_mode":"dontAsk","client":"CLI","version":"2.94.0","generation_id":"1607279bf6a148ad89078d445fbf9550","model":"glm-5.1"}
